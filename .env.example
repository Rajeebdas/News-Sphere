# Local dev only: browser → NewsAPI (allowed on localhost for Developer plan).
# https://newsapi.org/register
VITE_API_KEY=

# Optional: ISO country code for headlines (default in app is in).
# VITE_NEWS_COUNTRY=us

# Netlify (production): Site settings → Environment variables → add NEWS_API_KEY
# Use the same NewsAPI key value; it stays on the server (never in the JS bundle).
# NEWS_API_KEY=
